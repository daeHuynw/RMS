RMS_MYSQL_HOST=127.0.0.1
RMS_MYSQL_PORT=3306
RMS_MYSQL_DATABASE=rms_db
RMS_MYSQL_USER=rms_learn
RMS_MYSQL_PASSWORD=change-me

# openssl rand -base64 48
RMS_JWT_SECRET=change-me-use-openssl-rand

# Tuỳ chọn: múi giờ nhà hàng cho dashboard (mặc định Asia/Ho_Chi_Minh). DB luôn lưu UTC.
# RMS_TIME_ZONE=Asia/Ho_Chi_Minh

# Tuỳ chọn: quá giờ đặt bao nhiêu phút mà chưa check-in thì lượt đặt tự chuyển NO_SHOW (mặc định 30)
# RMS_NO_SHOW_GRACE_MINUTES=30

# Tuỳ chọn: thư mục ảnh món (mặc định uploads/menu)
# RMS_MENU_DIR=uploads/menu

# Tuỳ chọn: origin được mở WebSocket /ws của màn bếp, cách nhau bởi dấu phẩy
# (mặc định http://localhost:5173,http://127.0.0.1:5173). Mở qua IP LAN thì thêm http://<IP>:5173.
# RMS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
